{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DOKIII Installer",
  "version": "2.2.1",
  "identifier": "com.dokiii.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DOKIII Setup",
        "width": 944,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
